# ══════════════════════════════════════════════════════
#  ZombieRun Crash — Environment Configuration Template
#  Copy to .env and fill in your values before starting.
#  NEVER commit .env to version control.
# ══════════════════════════════════════════════════════

# ── Node ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# ── MongoDB ───────────────────────────────────────────
# Local dev: mongodb://localhost:27017/zombierun
# Docker:    mongodb://mongo:27017/zombierun
# Atlas:     mongodb+srv://user:pass@cluster.mongodb.net/zombierun
MONGODB_URI=mongodb://localhost:27017/zombierun

# ── Redis ─────────────────────────────────────────────
# Used for: idempotency keys, rate limiting, pub/sub
# Local dev: redis://localhost:6379
# Docker:    redis://redis:6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
# Minimum 32 chars; 64 chars (512 bits) recommended
JWT_SECRET=CHANGE_ME_generate_64_random_hex_chars_here

# Access token TTL (passed to jsonwebtoken — supports "15m", "1h", "1d")
JWT_ACCESS_TTL=15m
# Refresh token TTL
JWT_REFRESH_TTL=7d

# ── CORS ──────────────────────────────────────────────
# Comma-separated list of allowed origins
# Dev: http://localhost:5173
# Prod: https://your-domain.com
CORS_ORIGINS=http://localhost:5173

# ── Game Configuration ────────────────────────────────
# Betting phase duration in milliseconds (default: 10000 = 10s)
BETTING_PHASE_MS=7000
# Delay between rounds in milliseconds (default: 5000 = 5s)
INTER_ROUND_DELAY_MS=5000
# House edge percentage (default: 3)
HOUSE_EDGE_PERCENT=3

# ── Rate Limiting ─────────────────────────────────────
# Max requests per window per IP for the REST API
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Admin ─────────────────────────────────────────────
# Bootstrap admin credentials (used ONLY on first startup to create the admin user)
# Remove or leave blank in production after first run
BOOTSTRAP_ADMIN_EMAIL=admin@zombierun.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
BOOTSTRAP_ADMIN_USERNAME=admin
